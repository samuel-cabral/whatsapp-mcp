<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.samuelcabral.whatsapp-daemon</string>
  <!-- Must be a STABLE absolute path to node. Do not paste `which node`: under fnm
       and nvm that is a per-shell path that stops existing when the shell does, and
       KeepAlive would then relaunch this forever against a missing binary.
       Get the right one with: node -e 'console.log(process.execPath)' -->
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/whatsapp-mcp/build/daemon/index.js</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/.whatsapp-mcp/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/.whatsapp-mcp/daemon.log</string>
</dict>
</plist>
